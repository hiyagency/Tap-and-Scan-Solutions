NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LEAD_FINGERPRINT_SECRET=

# Reserved for future native Web Push delivery. Not required for in-app sync
# or foreground device notifications. Never expose the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@hiy.agency

# NimbusPost API v2. Server-only credentials.
NIMBUSPOST_API_KEY=
NIMBUSPOST_API_SECRET=
NIMBUSPOST_PICKUP_PINCODE=
# Verified pickup warehouse ID from your NimbusPost account.
NIMBUSPOST_WAREHOUSE_ID=
# Optional fixed courier ID; otherwise choose the cheapest valid prepaid rate.
NIMBUSPOST_COURIER_ID=
# Set true only after verifying your account's rate and shipment responses.
NIMBUSPOST_VERIFIED=false

# Actual packed parcel measurements, not the bare card dimensions.
PARCEL_LENGTH_CM=
PARCEL_WIDTH_CM=
PARCEL_UNIT_HEIGHT_CM=
PARCEL_UNIT_WEIGHT_KG=
# Keep payments closed until PayU and launch verification are completed.
COMMERCE_LIVE=false
